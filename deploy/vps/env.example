# /etc/takar.env on the VPS (0600 root). The systemd units read it through
# EnvironmentFile; it is never baked into a release artifact.
#
# Runtime role: least privilege, RLS enforced by Postgres.
DATABASE_URL=postgresql://takar_app:CHANGE_ME@HOST/DB?sslmode=require
# Owner role: only the takar-migrate oneshot uses it (migrations + grants).
MIGRATE_DATABASE_URL=postgresql://OWNER:CHANGE_ME@HOST/DB?sslmode=require
# Must match the password inside DATABASE_URL; grant.sql re-applies it.
TAKAR_APP_PASSWORD=CHANGE_ME
# Random 32+ bytes. The API refuses nothing, but the dev default is public.
JWT_SECRET=CHANGE_ME
PORT=3001
RUST_LOG=info,tower_http=info
