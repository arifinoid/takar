# takar-api
PORT=3001
DATABASE_URL=postgres://takar:takar@127.0.0.1:5432/takar
JWT_SECRET=dev-only-change-me
OTP_TTL_SECONDS=300
JWT_TTL_SECONDS=86400

# Fixed OTP for local sign-in. Debug builds use it instead of a random code,
# so any contact can sign in with it; release builds always randomize.
DEV_OTP_CODE=000000

# OTP delivery. Optional: with no provider configured, debug builds write the
# code to the log and release builds refuse to deliver.
# EMAIL_PROVIDER=brevo            # free 300/day, needs a verified sender
# BREVO_API_KEY=
# EMAIL_FROM=noreply@example.id
# EMAIL_FROM_NAME=Takar
# WHATSAPP_PROVIDER=fonnte        # free trial quota
# FONNTE_TOKEN=

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001

# compose.yaml
POSTGRES_PORT=5432
